# Copy to .env.local and fill in.

# Required — the reasoning engine. Free tier at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Required for physical-world context (terrain, flood zone, parcel, utilities,
# county market data). Without it Nexus still runs on OpenStreetMap alone, and
# the evidence panel reports the missing datasets as explicit gaps.
MIREYE_API_TOKEN=

# Optional overrides.
# MIREYE_BASE_URL=https://api.mireye.com
# Groq model. Default is openai/gpt-oss-120b; llama-3.3-70b-versatile is the tested fallback.
# NEXUS_MODEL=openai/gpt-oss-120b
